        <mxCell id="final-resolution" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Export a NEW Excel; preserve original data and append checking results.&lt;br&gt;Appendix / schema: T/F or blank if unknown.&lt;br&gt;BLUE &amp;gt; YELLOW &amp;gt; GREEN / RED.&lt;br&gt;Add manual &quot;Remark&quot; (blank by default), or reuse an existing Remark column.&lt;br&gt;Optional --remarks-from: import by exact Building + full Point Name.&lt;br&gt;Only empty Remark cells may be filled; conflicting notes abort. Remarks NEVER affect checking." vertex="1">
          <mxGeometry height="170" width="430" x="350" y="810" as="geometry" />
        </mxCell>
        <mxCell id="resolution-blue" parent="1" source="final-resolution" target="final-blue-check" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="final-blue-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="BLUE multiple-mapping flag?" vertex="1">
          <mxGeometry height="100" width="280" x="420" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="blue-yes" parent="1" source="final-blue-check" target="final-blue" edge="1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
