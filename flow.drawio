        <mxCell id="scan-read" parent="scan-process" style="rounded=0;whiteSpace=wrap;html=1;" value="Read ALL documents from DB[CSV &lt;font color=&quot;#26a69a&quot;&gt;&quot;Building &amp; Block Code&quot;&lt;/font&gt;][&lt;font color=&quot;#ab47bc&quot;&gt;&quot;enm_semantic_schema&quot;&lt;/font&gt;].&lt;br&gt;Use &lt;font color=&quot;#fb8c00&quot;&gt;&quot;point base name&quot;&lt;/font&gt; derived from &lt;font color=&quot;#26a69a&quot;&gt;&quot;Point Name&quot;&lt;/font&gt;, not the CSV base-name column." vertex="1">
          <mxGeometry height="90" width="600" x="50" y="70" as="geometry" />
