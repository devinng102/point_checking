        <mxCell id="final-blue" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" value="&amp;lt;mark the final result: multiple mappings (blue)&amp;gt;&lt;br&gt;Keep ALL reasons, including &lt;font color=&quot;#fb8c00&quot;&gt;&quot;Device ID&quot;&lt;/font&gt; review." vertex="1">
          <mxGeometry height="120" width="280" x="850" y="1040" as="geometry" />
