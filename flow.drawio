        <mxCell id="scan-found" parent="scan-process" style="rhombus;whiteSpace=wrap;html=1;" value="In ANY document:&lt;br&gt;&quot;System&quot; -&amp;gt; &quot;Equipment&quot; / &quot;MISC&quot; -&amp;gt; derived group&lt;br&gt;-&amp;gt; parameter object with &quot;point_name&quot; equal to the original full &quot;Point Name&quot;?&lt;br&gt;Group alone is NOT a match." vertex="1">
