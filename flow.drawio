        <mxCell id="mapping-blue-return" parent="E50qB_bewiRri_-YFIzX-2" source="mapping-blue-flag" target="E50qB_bewiRri_-YFIzX-11" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=1;entryY=0.5;">
