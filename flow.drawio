        <mxCell id="misc-main-unknown" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Appendix=Unknown: leave blank.&lt;br&gt;Unresolved MISC relevance.&lt;br&gt;No error: scan derived group AND full &quot;Point Name&quot;, yielding schema T/F.&lt;br&gt;Error: schema blank.&lt;br&gt;Review required; preserve BLUE." vertex="1">
