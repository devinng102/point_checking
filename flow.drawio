        <mxCell id="misc-relevance-read-gate" parent="misc-relevance-process" source="misc-relevance-read" target="misc-relevance-gate" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="misc-relevance-accepted" parent="misc-relevance-process" style="rounded=0;whiteSpace=wrap;html=1;" value="Provisionally accept relevance.&lt;br&gt;Check unchanged &quot;iBMS Parameters&quot; key AND exact full &quot;Point Name&quot;.&lt;br&gt;Missing parameter / point is Schema=F, NOT Appendix=F." vertex="1">
          <mxGeometry height="110" width="300" x="30" y="420" as="geometry" />
