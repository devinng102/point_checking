        <mxCell id="misc-relevance-process" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;container=1;" value="&lt;h2&gt;MISC Relevance: Option Two&lt;/h2&gt;" vertex="1">
          <mxGeometry height="1230" width="720" x="-1620" y="-60" as="geometry" />
        </mxCell>
        <mxCell id="misc-relevance-read" parent="misc-relevance-process" style="rounded=0;whiteSpace=wrap;html=1;" value="Read ALL schema documents in the input building.&lt;br&gt;Keep every distinct MISC Function candidate.&lt;br&gt;For EACH candidate, inspect &quot;System&quot; -&amp;gt; &quot;MISC&quot; -&amp;gt; derived group.&lt;br&gt;Do not infer an expected System from Point Name." vertex="1">
          <mxGeometry height="100" width="640" x="40" y="70" as="geometry" />
