        <mxCell id="misc-relevance-unknown" parent="misc-relevance-process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Relevance UNKNOWN, not unrelated.&lt;br&gt;Record missing System, MISC or group.&lt;br&gt;Retain candidate with &quot;Schema Match&quot;=null.&lt;br&gt;Do NOT silently discard it." vertex="1">
