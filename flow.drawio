        <mxCell id="parse-point-name" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="CHECKING ONLY: split &lt;font color=&quot;#26a69a&quot;&gt;&quot;Point Name&quot;&lt;/font&gt; at its LAST hyphen.&lt;br&gt;&lt;font color=&quot;#fb8c00&quot;&gt;&quot;derived Function Code&quot;&lt;/font&gt; = last complete segment; &lt;font color=&quot;#fb8c00&quot;&gt;&quot;derived point base name&quot;&lt;/font&gt; = everything before it.&lt;br&gt;Do not use CSV &lt;font color=&quot;#26a69a&quot;&gt;&quot;Function or Status Code&quot;&lt;/font&gt; or &lt;font color=&quot;#26a69a&quot;&gt;&quot;point name (without function code)&quot;&lt;/font&gt; as checking inputs; KEEP both columns and original values in Excel export.&lt;br&gt;&lt;font color=&quot;#26a69a&quot;&gt;&quot;Floor Code&quot;&lt;/font&gt; / &lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment ID / System ID / Room ID&quot;&lt;/font&gt; may be blank." vertex="1">
          <mxGeometry height="100" width="760" x="190" y="-165" as="geometry" />
        </mxCell>
        <mxCell id="parse-to-function" parent="1" source="parse-point-name" target="Au464GKHaQkNzhSAhbhp-1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="matching-rules" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Data sources and GENERAL matching rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ab47bc&quot;&gt;&quot;UAT ASL&quot;&lt;/font&gt; connection: &lt;font color=&quot;#ab47bc&quot;&gt;&quot;MASTER&quot;&lt;/font&gt; database, &lt;font color=&quot;#ab47bc&quot;&gt;&quot;appendix_b&quot;&lt;/font&gt; collection.&lt;br&gt;Target database = CSV &lt;font color=&quot;#26a69a&quot;&gt;&quot;Building &amp; Block Code&quot;&lt;/font&gt;; collection = &lt;font color=&quot;#ab47bc&quot;&gt;&quot;enm_semantic_schema&quot;&lt;/font&gt;.&lt;br&gt;CSV &lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment Code / System / Room Code&quot;&lt;/font&gt; matches &lt;font color=&quot;#ab47bc&quot;&gt;&quot;appendix_b&quot;&lt;/font&gt; &lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment Code&quot;&lt;/font&gt; (a code, e.g. ACC / CHR/ACC/WCC).&lt;br&gt;&lt;font color=&quot;#ab47bc&quot;&gt;&quot;appendix_b&quot;&lt;/font&gt; &lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment&quot;&lt;/font&gt; is a mapped NAME (e.g. Chiller), used as the schema hierarchy key; NOT an &lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment Code&quot;&lt;/font&gt;.&lt;br&gt;&lt;font color=&quot;#26a69a&quot;&gt;&quot;Point Name&quot;&lt;/font&gt; supplies &lt;font color=&quot;#fb8c00&quot;&gt;&quot;derived Function Code&quot;&lt;/font&gt; and &lt;font color=&quot;#fb8c00&quot;&gt;&quot;derived point base name&quot;&lt;/font&gt; for checking only.&lt;br&gt;GENERAL &lt;font color=&quot;#26a69a&quot;&gt;&quot;Function or Status Code&quot;&lt;/font&gt; rule: exact first; if no match, RegExp for the escaped complete token bounded by start/end or '/'. Applies to ALL codes and all Function lookup stages; never an arbitrary substring or a hard-coded example list.&lt;br&gt;Examples only: FALM / TFALM match FALM/TFALM; S does not match SWT / SS.&lt;br&gt;Function-only multiple records do not trigger BLUE. Different mappings after &lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment Code&quot;&lt;/font&gt; / &lt;font color=&quot;#78909c&quot;&gt;&quot;MISC&quot;&lt;/font&gt; checking do." vertex="1">
          <mxGeometry height="360" width="700" x="-800" y="-450" as="geometry" />
        </mxCell>
        <mxCell id="device-numeric" parent="Au464GKHaQkNzhSAhbhp-16" style="rhombus;whiteSpace=wrap;html=1;" value="Removed suffix is&lt;br&gt;1-2 digits only?" vertex="1">
          <mxGeometry height="100" width="220" x="40" y="240" as="geometry" />
        </mxCell>
