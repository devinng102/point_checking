          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="final-yellow-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="Unknown Appendix / schema?&lt;br&gt;Unresolved MISC relevance,&lt;br&gt;Device ID review or checking error?" vertex="1">
          <mxGeometry height="100" width="280" x="420" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="yellow-yes" parent="1" source="final-yellow-check" target="final-yellow" edge="1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
