          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="checking-error-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" value="Checking / parsing errors: record the reason and set a YELLOW flag.&lt;br&gt;Do not convert failed execution into False; leave unknown values blank.&lt;br&gt;Continue candidate checks only where possible.&lt;br&gt;Two unsuccessful &lt;font color=&quot;#fb8c00&quot;&gt;&quot;Device ID&quot;&lt;/font&gt; trims are normal Appendix=False, NOT a checking error.&lt;br&gt;BLUE still overrides YELLOW." vertex="1">
          <mxGeometry height="160" width="280" x="850" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="error-note-resolution" parent="1" source="checking-error-note" target="final-resolution" edge="1" value="Any checking error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.7;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1190" y="1530" /><mxPoint x="1190" y="941" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="remark-export-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Manual Remark lifecycle (outside checking logic)&lt;/b&gt;&lt;br&gt;User writes short notes in &quot;Remark&quot; and saves the previous Excel.&lt;br&gt;Recheck original point list with --remarks-from previous.xlsx.&lt;br&gt;Match EXACT &quot;Building &amp; Block Code&quot; + FULL original &quot;Point Name&quot;.&lt;br&gt;Keep literal text / spaces; do not infer notes from Checking Reasons.&lt;br&gt;Same key + different notes: abort, never overwrite.&lt;br&gt;Old notes without new rows: warn; preserve the previous file.&lt;br&gt;Existing Remark column is reused; no duplicate manual column.&lt;br&gt;Documented cases: SPECIAL_CASES.md (not a rule or auto-note source)." vertex="1">
          <mxGeometry height="220" width="610" x="1260" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="terminology-legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Quoted names and text-color legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ab47bc&quot;&gt;&quot;MASTER&quot;, &quot;appendix_b&quot;, &quot;enm_semantic_schema&quot;&lt;/font&gt;: database / collection names.&lt;br&gt;&lt;font color=&quot;#26a69a&quot;&gt;&quot;Equipment Code&quot;, &quot;Equipment&quot;, &quot;Point Name&quot;&lt;/font&gt;: exact source-field names; Code and mapped name are DIFFERENT fields.&lt;br&gt;&lt;font color=&quot;#fb8c00&quot;&gt;&quot;derived Function Code&quot;, &quot;derived point base name&quot;, &quot;Device ID&quot;&lt;/font&gt;: checking-only derived values; never overwrite original Excel cells.&lt;br&gt;&lt;font color=&quot;#78909c&quot;&gt;&quot;MISC&quot;&lt;/font&gt;: literal schema hierarchy key.&lt;br&gt;TEXT colors identify names; result BACKGROUND colors indicate green / red / yellow / blue status." vertex="1">
          <mxGeometry height="200" width="700" x="-800" y="-700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
