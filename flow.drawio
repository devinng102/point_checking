        </mxCell>
        <mxCell id="misc-accepted-aggregate" parent="misc-relevance-process" source="misc-relevance-accepted" target="misc-relevance-aggregate" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.2;entryY=0;">
