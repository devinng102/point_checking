        <mxCell id="misc-relevance-gate" parent="misc-relevance-process" style="rhombus;whiteSpace=wrap;html=1;" value="Candidate &quot;System&quot;&lt;br&gt;-&amp;gt; &quot;MISC&quot;&lt;br&gt;-&amp;gt; derived group exists&lt;br&gt;in ANY document?" vertex="1">
