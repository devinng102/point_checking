        </mxCell>
        <mxCell id="misc-accepted-result" parent="misc-relevance-process" style="rounded=0;whiteSpace=wrap;html=1;" value="Appendix=T.&lt;br&gt;Aggregate mapped-path results if all agree; otherwise schema is blank.&lt;br&gt;Single mapping missing parameter / point: T/F, red.&lt;br&gt;Multiple accepted mappings: blue." vertex="1">
          <mxGeometry height="150" width="300" x="30" y="940" as="geometry" />
        </mxCell>
        <mxCell id="misc-unknown-result" parent="misc-relevance-process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Appendix UNKNOWN: leave blank.&lt;br&gt;If no checking error: scan ALL documents for derived group AND full original &quot;Point Name&quot;.&lt;br&gt;Schema=T/F from scan, not mapped path.&lt;br&gt;YELLOW review, unless BLUE.&lt;br&gt;Never turn unknown + F into F/F green." vertex="1">
          <mxGeometry height="150" width="300" x="390" y="940" as="geometry" />
        </mxCell>
        <mxCell id="misc-all-yes" parent="misc-relevance-process" source="misc-all-accepted" target="misc-accepted-result" edge="1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.2;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="misc-all-no" parent="misc-relevance-process" source="misc-all-accepted" target="misc-unknown-result" edge="1" value="No, including mixed accepted / unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.8;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="misc-error-result" parent="misc-relevance-process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Query / relevant structure error: record diagnostics; schema stays blank.&lt;br&gt;Unverified group relevance: Appendix stays blank.&lt;br&gt;Parameter error within accepted group: keep Appendix=T.&lt;br&gt;Do not hide errors with a successful scan. BLUE still overrides YELLOW." vertex="1">
          <mxGeometry height="90" width="640" x="40" y="1120" as="geometry" />
        </mxCell>
