        <mxCell id="scan-process" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;container=1;" value="&lt;h2&gt;Appendix=False / Unknown: Full Point Name Scan&lt;/h2&gt;" vertex="1">
